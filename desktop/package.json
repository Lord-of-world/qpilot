{
  "name": "qpilot-desktop",
  "productName": "qpilot",
  "version": "0.10.0",
  "description": "qpilot as a desktop app for macOS and Windows: the Next.js server runs inside Electron",
  "private": true,
  "main": "main.js",
  "scripts": {
    "build:web": "npm --prefix .. run build",
    "start": "npm run build:web && electron .",
    "dev": "electron .",
    "dist": "npm run build:web && electron-builder --mac --win",
    "dist:mac": "npm run build:web && electron-builder --mac",
    "dist:win": "npm run build:web && electron-builder --win"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "sh.brox.qpilot",
    "productName": "qpilot",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null
    },
    "dmg": {
      "title": "qpilot"
    },
    "afterPack": "scripts/after-pack.js",
    "artifactName": "qpilot-${version}-${os}-${arch}.${ext}",
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "qpilot",
      "uninstallDisplayName": "qpilot"
    }
  }
}
