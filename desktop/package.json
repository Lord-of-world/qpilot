{
  "name": "qpilot-desktop",
  "productName": "qpilot",
  "version": "0.10.0",
  "description": "qpilot as a macOS app: the Next.js server runs inside Electron",
  "private": true,
  "main": "main.js",
  "scripts": {
    "build:web": "npm --prefix .. run build",
    "start": "npm run build:web && electron .",
    "dev": "electron .",
    "dist": "npm run build:web && electron-builder --mac"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "sh.brox.qpilot",
    "productName": "qpilot",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "dmg": {
      "title": "qpilot"
    },
    "afterPack": "scripts/after-pack.js"
  }
}
